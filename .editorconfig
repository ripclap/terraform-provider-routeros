root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{yml,yaml,json,tf,md}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
# Two trailing spaces is a hard line break in Markdown.
trim_trailing_whitespace = false
